{
  "name": "arcus",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db": "bash scripts/start-db.sh",
    "api": "bun --cwd apps/api dev",
    "frontend": "bun --cwd apps/frontend dev",
    "dev:infra": "docker compose --env-file apps/api/.env -f docker-compose.yml up postgres minio dragonfly",
    "dev:api": "bun --cwd apps/api dev",
    "dev:api:app": "bun --cwd apps/api dev:app",
    "dev:frontend": "bun --cwd apps/frontend dev",
    "dev:executor": "bun --cwd apps/executor dev",
    "dev:embedder": "bun --cwd apps/embedder dev",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "lint": "turbo run lint",
    "check": "turbo run check",
    "typecheck": "turbo run typecheck",
    "validate": "bun run format && turbo run lint typecheck build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "turbo": "^2.5.0"
  }
}
